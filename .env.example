# Salin file ini ke .env dan isi nilai yang sesuai.
# Jangan commit file .env ke git.

PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=db_fnb_pemesanan
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=50
DB_CONNECT_TIMEOUT_MS=10000

# JWT – minimal 32 karakter acak untuk production
JWT_SECRET=GANTI_DENGAN_SECRET_PANJANG_DAN_ACAK_MINIMAL_32_KARAKTER
JWT_EXPIRES_IN=15m

# CORS – pisahkan dengan koma untuk multiple origin
# Contoh production: ALLOWED_ORIGINS=https://app.ilangarah.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001